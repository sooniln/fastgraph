@file:Suppress("UnusedImport")

package io.github.sooniln.fastgraph.primitives.collections

import io.github.sooniln.fastcollect.FastIterator
import io.github.sooniln.fastcollect.Hash
import io.github.sooniln.fastcollect.MutableFastIterator
import io.github.sooniln.fastcollect.${keySubpackage}.${Name}Map
import io.github.sooniln.fastcollect.${keySubpackage}.Mutable${Name}Map
import io.github.sooniln.fastcollect.${keySubpackage}.Mutable${KeyType}Iterator
import io.github.sooniln.fastcollect.${keySubpackage}.Mutable${KeyType}Set
import io.github.sooniln.fastcollect.${keySubpackage}.${KeyType}Consumer
<% if (!isReferenceValue) { %>
import io.github.sooniln.fastcollect.${keySubpackage}.${KeyType}${ValueType}Consumer
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Collection
<% if (KeyType != ValueType) { %>
import io.github.sooniln.fastcollect.${valueSubpackage}.${ValueType}Consumer
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Iterator
<% } %>
<% } else { %>
import io.github.sooniln.fastcollect.${keySubpackage}.${KeyType}AnyConsumer
<% } %>
import io.github.sooniln.fastgraph.primitives.ArrayUtils
import kotlin.jvm.JvmOverloads
import kotlin.math.max
import kotlin.math.min
import kotlin.random.Random

internal class Graph${Name}HashMap${Generics} @JvmOverloads constructor(
    capacity: Int = 0,
<% if (!isReferenceValue) { %>
    /** The default value should be the value that is ideally least likely to occur in the map. */
    private val defaultValue: ${ValueType} = ${DefaultValue},
<% } %>
) : Mutable${Name}Map${Generics} {

    public constructor(map: ${Name}Map${Generics}): this() { putAll(map) }
    public constructor(map: Map<${KeyType}, ${ValueType}>): this() { putAll(map) }

    private var keysArr = EMPTY_KEY_ARRAY
<% if (!isReferenceValue) { %>
    private var valuesArr = EMPTY_VALUE_ARRAY
<% } else { %>
    @Suppress("UNCHECKED_CAST")
    private var valuesArr = EMPTY_VALUE_ARRAY as Array<${ValueType}?>

    private inline val defaultValue: ${ValueType}? get() = null
<% } %>

    // threshold + size == capacity (rehash once threshold <= 0, if we haven't allocated yet then threshold.inv() is
    // our initial capacity)
    private var threshold = MIN_INITIAL_CAPACITY.inv()

    override var size: Int = 0
        private set

    init {
        ensureCapacity(capacity)
    }

    override fun isDefaultValue(value: ${ValueType}${Nullable}): Boolean = value == defaultValue

    /**
     * Ensures that the map can hold at least given number of key/value pairs without any further resizing of the
     * backing array.
     */
    public fun ensureCapacity(capacity: Int) {
        require(capacity >= 0) { "Capacity must be >= 0" }
        if (keysArr === EMPTY_KEY_ARRAY) {
            threshold = min(threshold, capacity.inv())
        } else if (capacity > threshold + size) {
            rehash(capacity)
        }
    }

    /**
     * Reduces the size of the backing array to the minimum required to hold the current number of elements.
     */
    public fun trimToSize() {
        rehash(size)
    }

    override fun containsKey(key: ${KeyType}): Boolean = findSlot(key, { true }, { false })

    override fun containsValue(value: ${ValueType}): Boolean {
        val keysArr = keysArr
        val valuesArr = valuesArr
        for (slot in keysArr.indices) {
            if (valuesArr[slot] == value && keysArr[slot] != EMPTY_KEY) return true
        }
        return false
    }

    override fun get(key: ${KeyType}): ${ValueType}${Nullable} = findSlot(key, { slot -> valuesArr[slot] }, { defaultValue })

    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    override fun getValue(key: ${KeyType}): ${ValueType} = findSlot(key, { slot -> valuesArr[slot] as ${ValueType} }, { throw NoSuchElementException() })

    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    override fun getOrDefault(key: ${KeyType}, defaultValue: ${ValueType}): ${ValueType} = findSlot(key, { slot -> valuesArr[slot] as ${ValueType} }, { defaultValue })

    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}${Nullable} {
        var returnValue = defaultValue
        set(key, {
            value
        }, { slot ->
            returnValue = valuesArr[slot]
            value
        })
        return returnValue
    }

    public fun putIfAbsent(key: ${KeyType}, value: ${ValueType}): ${ValueType}${Nullable} {
        set(key, { value }, { slot -> return valuesArr[slot] })
        return defaultValue
    }

    override fun set(key: ${KeyType}, value: ${ValueType}) {
        set(key, { value }, { value })
    }

    override fun remove(key: ${KeyType}): ${ValueType}${Nullable} {
        return findSlot(
            key,
            { slot ->
                val oldValue = valuesArr[slot]
                removeSlot(slot)
                oldValue
            },
            { defaultValue })
    }

    override fun clear() {
        if (keysArr !== EMPTY_KEY_ARRAY) {
            keysArr.fill(EMPTY_KEY)
            threshold += size
<% if (isReferenceValue) { %>
            valuesArr.fill(null)
<% } %>
        }
        size = 0
    }

    private inline fun <T> findSlot(key: ${KeyType}, onFind: (slot: Int) -> T, onFail: () -> T): T {
        require(key != EMPTY_KEY)

        val keysArr = keysArr
        val mask = keysArr.size - 1

        var slot = key.slot(mask)
        var currKey = keysArr[slot]
        while (currKey != EMPTY_KEY) {
            if (currKey == key) {
                return onFind(slot)
            }

            slot = (slot + 1) and mask
            currKey = keysArr[slot]
        }

        return onFail()
    }

    private inline fun set(key: ${KeyType}, onAdd: () -> ${ValueType}, onReplace: (slot: Int) -> ${ValueType}) {
        require(key != EMPTY_KEY)

        if (threshold <= 0) increaseCapacity()

        val keysArr = keysArr
        val mask = keysArr.size - 1

        var slot = key.slot(mask)
        var currKey = keysArr[slot]
        while (currKey != EMPTY_KEY) {
            if (currKey == key) {
                valuesArr[slot] = onReplace(slot)
                return
            }

            slot = (slot + 1) and mask
            currKey = keysArr[slot]
        }


        keysArr[slot] = key
        valuesArr[slot] = onAdd()
        threshold -= 1
        size += 1
    }

    private fun removeSlot(slot: Int) {
        val keysArr = keysArr
        val valuesArr = valuesArr
        val mask = keysArr.size - 1

        var currSlot = slot
        var nextSlot = (currSlot + 1) and mask
        var nextKey = keysArr[nextSlot]
        while (nextKey != EMPTY_KEY && nextKey.slotDistance(nextSlot, mask) > 0) {
            keysArr[currSlot] = nextKey
            valuesArr[currSlot] = valuesArr[nextSlot]

            currSlot = nextSlot
            nextSlot = (nextSlot + 1) and mask
            nextKey = keysArr[nextSlot]
        }
        keysArr[currSlot] = EMPTY_KEY
<% if (isReferenceValue) { %>
        valuesArr[currSlot] = null
<% } %>
        threshold += 1
        size -= 1
    }

    override fun putAll(from: ${Name}Map${Generics}) {
        if (from is Graph${Name}HashMap && from.size / 2 > size) {
            val oldKeysArr = keysArr
            val oldValuesArr = valuesArr

            resetTo(from)
            for (slot in oldKeysArr.indices) {
                val key = oldKeysArr[slot]
                if (key != EMPTY_KEY) {
                    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
                    putIfAbsent(key, oldValuesArr[slot] as ${ValueType})
                }
            }
            trimToSize()
        } else {
            ensureCapacity(max(size + (from.size / 2), from.size))
            for ((key, value) in from) {
                set(key, value)
            }
        }
    }

    override fun putAll(from: Map<out ${KeyType}, ${ValueType}>) {
        ensureCapacity(max(size + (from.size / 2), from.size))
        for ((key, value) in from) {
            set(key, value)
        }
    }

    private fun resetTo(from: Graph${Name}HashMap${Generics}) {
        check(!from.isEmpty())

        keysArr = from.keysArr.copyOf()
        valuesArr = from.valuesArr.copyOf()
        size = from.size
        threshold = from.threshold
    }

    private var _keys: Mutable${KeyType}Set? = null
    override val keys: Mutable${KeyType}Set get() {
        return _keys ?:
            object : Mutable${KeyType}Set {
                override val size: Int get() = this@Graph${Name}HashMap.size
                override fun contains(element: ${KeyType}): Boolean = containsKey(element)
                override fun add(element: ${KeyType}): Boolean = throw UnsupportedOperationException()
                override fun remove(element: ${KeyType}): Boolean = throw UnsupportedOperationException()
                override fun iterator(): Mutable${KeyType}Iterator = KeyIterator()
                override fun foreach(action: ${KeyType}Consumer) = foreachKey(action)
                override fun clear() = throw UnsupportedOperationException()
            }
            .also { _keys = it }
    }

    private var _values: Mutable${ValueCollectionType}${Generics}? = null
    override val values: Mutable${ValueCollectionType}${Generics} get() {
        return _values ?:
<% if (!isReferenceValue) { %>
            object : Mutable${ValueType}Collection {
<% } else { %>
            object : AbstractMutable${ValueCollectionType}${Generics}() {
<% } %>
                override val size: Int get() = this@Graph${Name}HashMap.size
                override fun contains(element: ${ValueType}): Boolean = containsValue(element)
                override fun add(element: ${ValueType}): Boolean = throw UnsupportedOperationException()
                override fun remove(element: ${ValueType}): Boolean = throw UnsupportedOperationException()
                override fun iterator(): Mutable${ValueIteratorType}${Generics} = ValueIterator()
<% if (!isReferenceValue) { %>
                override fun foreach(action: ${ValueType}Consumer) = this@Graph${Name}HashMap.foreach { _, value -> action.accept(value) }
<% } %>
                override fun clear() = throw UnsupportedOperationException()
            }
            .also { _values = it }
    }

    private fun increaseCapacity() {
        check(threshold <= 0)
        if (threshold < 0) {
            rehash(threshold.inv())
        } else {
            rehash(size shl 1)
        }
    }

    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    private fun rehash(capacity: Int) {
        check(capacity >= size)

        if (capacity == 0 && keysArr !== EMPTY_KEY_ARRAY) {
            keysArr = EMPTY_KEY_ARRAY
<% if (!isReferenceValue) { %>
            valuesArr = EMPTY_VALUE_ARRAY
<% } else { %>
            valuesArr = EMPTY_VALUE_ARRAY as Array<${ValueType}?>
<% } %>
            threshold = MIN_INITIAL_CAPACITY.inv()
            return
        }

        // for small capacities we force loadFactor to 1.0 to save memory (small array scans are likely to be fast)
        val actualLoadFactor = if (capacity <= FORCE_LOAD_FACTOR_MAX) 1.0 else .75

        val newLength = arraySize(capacity, actualLoadFactor)
        if (keysArr.size == newLength) return

        val newKeysArr = ${KeyType}Array(newLength)
        newKeysArr.fill(EMPTY_KEY)
<% if (!isReferenceValue) { %>
        val newValuesArr = ${ValueType}Array(newLength)
<% } else { %>
        val newValuesArr = arrayOfNulls<Any>(newLength) as Array<${ValueType}?>
<% } %>
        val newMask = newLength - 1

        for (slot in keysArr.indices) {
            val key = keysArr[slot]
            if (key != EMPTY_KEY) setRehashing(newKeysArr, newValuesArr, newMask, key, valuesArr[slot])
        }

        keysArr = newKeysArr
        valuesArr = newValuesArr

        // threshold must always maintain the invariant of at least 1 slot being open
        threshold = min((newLength * actualLoadFactor).toInt(), newMask) - size
    }

    // we can assume key doesn't exist in array
<% if (!isReferenceValue) { %>
    private fun setRehashing(keysArr: ${KeyType}Array, valuesArr: ${ValueType}Array, mask: Int, key: ${KeyType}, value: ${ValueType}) {
<% } else { %>
    private fun setRehashing(keysArr: ${KeyType}Array, valuesArr: Array<${ValueType}?>, mask: Int, key: ${KeyType}, value: ${ValueType}?) {
<% } %>
        var slot = key.slot(mask)
        var currKey = keysArr[slot]
        while (currKey != EMPTY_KEY) {
            slot = (slot + 1) and mask
            currKey = keysArr[slot]
        }

        keysArr[slot] = key
        valuesArr[slot] = value
    }

    override operator fun iterator(): MutableFastIterator<Mutable${Name}Map.MutableEntry${Generics}> = FastEntryIterator()

<% if (!isReferenceValue) { %>
    override fun foreach(action: ${KeyType}${ValueType}Consumer) {
<% } else { %>
    override fun foreach(action: ${KeyType}AnyConsumer${Generics}) {
<% } %>
        val keysArr = keysArr
        val valuesArr = valuesArr

        for (slot in keysArr.indices) {
            val key = keysArr[slot]
            if (key != EMPTY_KEY) {
                @Suppress("UNCHECKED_CAST", "USELESS_CAST")
                action.accept(key, valuesArr[slot] as ${ValueType})
            }
        }
    }

    override fun foreachKey(action: ${KeyType}Consumer) {
        val keysArr = keysArr

        for (slot in keysArr.indices) {
            val key = keysArr[slot]
            if (key != EMPTY_KEY) {
                action.accept(key)
            }
        }
    }

    private open inner class SlotIterator {
        private val keysArr = this@Graph${Name}HashMap.keysArr
        private val valuesArr = this@Graph${Name}HashMap.valuesArr
        private val mask = keysArr.size - 1

        private var slotsLeft = size
        private var slot = keysArr.size - 1
        private var previousSlot = -1

        init {
            if (slotsLeft > 0) decrement()
        }

        fun hasNext(): Boolean {
            return slotsLeft > 0
        }

        fun nextSlot() {
            if (slotsLeft <= 0) throw NoSuchElementException()
            previousSlot = slot
            if (--slotsLeft > 0) decrement()
        }

        fun key(): ${KeyType} = keysArr[previousSlot]
        @Suppress("UNCHECKED_CAST", "USELESS_CAST")
        fun value(): ${ValueType} = valuesArr[previousSlot] as ${ValueType}

        fun updateValue(newValue: ${ValueType}) {
            check(previousSlot != -1)
            if (keysArr !== this@Graph${Name}HashMap.keysArr) throw ConcurrentModificationException()

            valuesArr[previousSlot] = newValue
        }

        fun remove() {
            check(previousSlot != -1)
            if (keysArr !== this@Graph${Name}HashMap.keysArr) throw ConcurrentModificationException()

            removeSlot(previousSlot)
            previousSlot = -1

            // if removal wrapped all the way around to our next slot then we need to adjust
            if (keysArr[slot] == EMPTY_KEY) {
                slot = (slot - 1) and mask
            }
        }

        private fun decrement() {
            do {
                slot = (slot - 1) and mask
            } while (keysArr[slot] == EMPTY_KEY)
        }
    }

    private inner class KeyIterator : Mutable${KeyType}Iterator() {
        private val it = SlotIterator()

        override fun hasNext(): Boolean = it.hasNext()

        override fun next${KeyType}(): ${KeyType} {
            it.nextSlot()
            return it.key()
        }

        override fun remove() = it.remove()
    }

<% if (!isReferenceValue) { %>
    private inner class ValueIterator : Mutable${ValueIteratorType}${Generics}() {
<% } else { %>
    private inner class ValueIterator : Mutable${ValueIteratorType}${Generics} {
<% } %>
        private val it = SlotIterator()

        override fun hasNext(): Boolean = it.hasNext()

<% if (!isReferenceValue) { %>
        override fun next${ValueType}(): ${ValueType} {
<% } else { %>
        override fun next(): ${ValueType} {
<% } %>
            it.nextSlot()
            return it.value()
        }

        override fun remove() = it.remove()
    }

    private inner class FastEntryIterator: SlotIterator(), MutableFastIterator<Mutable${Name}Map.MutableEntry${Generics}>, Mutable${Name}Map.MutableEntry${Generics} {

        override val key: ${KeyType} get() = key()
        override var value: ${ValueType}
            get() = value()
            set(value) {
                updateValue(value)
            }

        override fun next(): Mutable${Name}Map.MutableEntry${Generics} {
            nextSlot()
            return this
        }

        override fun equals(other: Any?): Boolean = other is Map.Entry<*, *> && other.key == key && other.value == value
        override fun hashCode(): Int = key.hashCode() xor value.hashCode()
        override fun toString(): String = "\$key=\$value"
    }

    private fun ${KeyType}.slot(mask: Int): Int = this and mask
    private fun ${KeyType}.slotDistance(slot: Int, mask: Int): Int = (slot - this) and mask

    private companion object {
        // the value of a field in an uninitialized primitive array
        @Suppress("REDUNDANT_CALL_OF_CONVERSION_METHOD")
        private const val EMPTY_KEY = (-1).to${KeyType}()

        private val EMPTY_KEY_ARRAY = ${lowerKeyType}ArrayOf(EMPTY_KEY)
<% if (!isReferenceValue) { %>
        private val EMPTY_VALUE_ARRAY = ${ValueType}Array(1)
<% } else { %>
        private val EMPTY_VALUE_ARRAY = arrayOfNulls<Any?>(1)
<% } %>

        private const val MIN_INITIAL_CAPACITY = 3

        private const val CACHE_LINE_SIZE = 64 / ${KeyType}.SIZE_BYTES

        // we force the load factor to 1.0 up to the size of two cache lines
        private const val FORCE_LOAD_FACTOR_MAX = 2 * CACHE_LINE_SIZE

        private fun arraySize(capacity: Int, loadFactor: Double): Int {
            check(capacity >= 0)
            // array must always maintain the invariant of at least one slot remaining open
            val requiredArraySize = max((capacity / loadFactor).toInt(), capacity + 1)
            val actualArraySize = ArrayUtils.minPowerOfTwo(requiredArraySize)
            if (actualArraySize < requiredArraySize) throw Error("Required array length \$requiredArraySize is too large")
            return actualArraySize
        }
    }
}
